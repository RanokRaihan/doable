# ─── Server-side (not exposed to browser) ───
BACKEND_URL=http://localhost:8000/

# ─── Cookie lifetimes (in seconds, optional — defaults shown) ───
ACCESS_TOKEN_MAX_AGE=900
REFRESH_TOKEN_MAX_AGE=604800

# ─── Client-side (exposed to browser via NEXT_PUBLIC_ prefix) ───
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000/

# ─── Cloudinary (server-only — never expose API_SECRET to client) ───
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret